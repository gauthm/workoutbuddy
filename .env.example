# WorkoutBuddy — environment variables
# Copy this file to .env (repository root). All values are optional.
# Precedence: environment variable > settings table (initial setup) > default.
# AI API key: store only in the settings table, never in this file.

# Server listening host (default: settings 'network_host', otherwise 127.0.0.1)
HOST=127.0.0.1

# Listening port (default: settings 'network_port', otherwise 3000)
PORT=3000

# SQLite database path, relative to the working directory
# (default: ./data/workoutbuddy.db)
DB_PATH=./data/workoutbuddy.db

# In production, bind to 127.0.0.1 behind an authenticated HTTPS proxy/tunnel.
# The proxy must preserve Host and block direct access to the Node port.
# NODE_ENV=production
# PUBLIC_ORIGIN=https://workout.example.com
# Uncomment only with a trusted local proxy that rewrites the headers.
# TRUST_PROXY=loopback
