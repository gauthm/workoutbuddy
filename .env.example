# WorkoutBuddy — variables d'environnement
# Copier ce fichier en .env (racine du dépôt). Tout est optionnel.
# Précédence : variable d'environnement > table settings (setup initial) > défaut.
# Clé API IA : en table settings uniquement, jamais dans ce fichier.

# Hôte d'écoute du serveur (défaut : valeur settings 'network_host', sinon 127.0.0.1)
HOST=127.0.0.1

# Port d'écoute (défaut : valeur settings 'network_port', sinon 3000)
PORT=3000

# Chemin de la base SQLite, relatif au répertoire de lancement
# (défaut : ./data/workoutbuddy.db)
DB_PATH=./data/workoutbuddy.db
