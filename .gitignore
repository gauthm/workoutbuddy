# ── Dependencies ──────────────────────────────────────────────
node_modules/

# ── Local data (never tracked) ─────────────────────
data/
# Allow the data/ directory but ignore its contents
!data/.gitkeep

# ── Environment variables ─────────────────────────────────
.env
.env.*
!.env.example
# .env.example is intentionally tracked

# ── Downloaded vendors (regenerate with download-vendors.js) ─
public/vendor/

# ── Exercise images (large, regenerable through import) ─
public/exercises/images/
# Allow the empty directory
!public/exercises/images/.gitkeep

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*

# ── Operating system ───────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ── Editors ─────────────────────────────────────────────────
# VSCode
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains
.idea/
*.iml

# Vim / Neovim
*.swp
*.swo
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
Session.vim
.netrwhist

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
auto-save-list
tramp
.\#*

# ── Test coverage ───────────────────────────────────────
coverage/
.nyc_output/

# ── Temporary files ─────────────────────────────────────
*.tmp
*.temp
*.bak
*.orig
__pycache__/
*.pyc

# ── Generated exports ──────────────────────────────────────────
workoutbuddy-export-*.json
*.export.csv
# Playwright browser reports and traces
test-results/

# Secrets and databases outside their usual directories
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.key
*.pem
*.p12
*.pfx
