#!/usr/bin/python3
import getpass, os, pathlib, pty, re, select, subprocess, json, grp, termios, fcntl, struct
if os.geteuid() != 0: raise SystemExit('Run with sudo.')
user=input('Authelia username (letters, digits, hyphen, underscore): ').strip()
if not re.fullmatch(r'[a-zA-Z0-9_-]{1,64}',user): raise SystemExit('Invalid username')
pw=getpass.getpass('Unique password (at least 20 characters): ')
if len(pw.strip())<20 or len(set(pw))<8: raise SystemExit('Use a unique password of at least 20 characters with sufficient variety')
if pw!=getpass.getpass('Confirm: '): raise SystemExit('Confirmation does not match')
master,slave=pty.openpty()
fcntl.ioctl(slave,termios.TIOCSWINSZ,struct.pack("HHHH",24,100,0,0))
attrs=termios.tcgetattr(slave);attrs[3] &= ~termios.ECHO;termios.tcsetattr(slave,termios.TCSANOW,attrs)
proc=subprocess.Popen(['/usr/local/bin/authelia','crypto','hash','generate','argon2','--no-confirm'],stdin=slave,stdout=slave,stderr=slave,start_new_session=True,preexec_fn=lambda: fcntl.ioctl(0,termios.TIOCSCTTY,0))
os.close(slave)
data=b'';sent=False
while True:
 try: chunk=os.read(master,4096)
 except OSError: break
 if not chunk: break
 data+=chunk
 if not sent and b'Password:' in data:
  os.write(master,pw.encode()+b'\r');sent=True
proc.wait();os.close(master);pw=None
match=re.search(rb'Digest:\s*(\$argon2id\$[^\s]+)',data)
if proc.returncode or not match: raise SystemExit('Hashing failed (no secret displayed)')
config=pathlib.Path('/etc/authelia/users.yml')
body='users:\n  '+user+':\n    displayname: WorkoutBuddy\n    password: '+json.dumps(match[1].decode())+'\n    email: owner@__DOMAIN__\n'
if config.exists():
 subprocess.run(['systemctl','start','workoutbuddy-backup.service'],check=True)
tmp=config.with_suffix('.new');tmp.write_text(body);os.chmod(tmp,0o640);os.chown(tmp,0,grp.getgrnam('authelia').gr_gid);os.replace(tmp,config)
subprocess.run(['/usr/local/bin/authelia','config','validate','--config','/etc/authelia/configuration.yml'],check=True)
subprocess.run(['systemctl','restart','authelia'],check=True)
print('Account enabled. Open the Authelia HTTPS portal and register a TOTP authenticator.')
print('The verification link is in /var/lib/authelia/notifications.txt; read it only in your SSH terminal.')
