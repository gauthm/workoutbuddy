#!/usr/bin/python3
"""Cache Authelia and production dependency versions; show status offline."""
import argparse
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timezone, timedelta
import json
import os
from pathlib import Path
import re
import subprocess
import urllib.parse
import urllib.request

STATE = Path('/var/lib/authelia-update-check/status.json')
API = 'https://api.github.com/repos/authelia/authelia/releases/latest'
RELEASES = 'https://github.com/authelia/authelia/releases'
APP = Path('/usr/local/lib/workoutbuddy')


def inventory():
    """Read deployed versions, including transitive npm and browser dependencies."""
    packages = json.loads((APP / 'package-lock.json').read_text())['packages']
    items = {}
    for location, package in packages.items():
        if not location or package.get('dev'):
            continue
        manifest = APP / location / 'package.json'
        if not manifest.exists() and package.get('optional'):
            continue
        installed = json.loads(manifest.read_text())
        items[location] = {'name': installed['name'], 'current': installed['version']}
    vendors = [('vue', 'vue.esm-browser.prod.js', r'vue v(\d+\.\d+\.\d+)'),
               ('chart.js', 'chart.umd.min.js', r'Chart\.js v(\d+\.\d+\.\d+)')]
    known_files = {filename for _, filename, _ in vendors}
    unknown_files = {path.relative_to(APP / 'public/vendor').as_posix()
                     for path in (APP / 'public/vendor').rglob('*.js')} - known_files
    if unknown_files:
        raise ValueError('Browser libraries missing version tracking: ' + ', '.join(sorted(unknown_files)))
    for name, filename, pattern in vendors:
        with (APP / 'public/vendor' / filename).open() as stream:
            match = re.search(pattern, stream.read(4096))
        if not match:
            raise ValueError('Cannot identify deployed browser library: ' + name)
        items['public/vendor/' + filename] = {'name': name, 'current': match.group(1)}
    return items


def registry_latest(name):
    url = 'https://registry.npmjs.org/' + urllib.parse.quote(name, safe='') + '/latest'
    request = urllib.request.Request(url, headers={'User-Agent': 'workoutbuddy-update-check'})
    with urllib.request.urlopen(request, timeout=12) as response:
        latest = json.load(response)['version']
    version(latest)
    return latest


def check_dependencies(state):
    previous = state.get('dependencies', {})
    try:
        items = {key: dict(item) for key, item in inventory().items()}
        names = sorted({item['name'] for item in items.values()})
        with ThreadPoolExecutor(max_workers=8) as workers:
            latest = dict(zip(names, workers.map(registry_latest, names)))
        for item in items.values():
            version(item['current'])
            item['latest'] = latest[item['name']]
        state['dependencies'] = dict(items=items, failed=False,
                                     checked_at=datetime.now(timezone.utc).isoformat())
        return False
    except Exception as error:
        state['dependencies'] = dict(previous, failed=True)
        print('Production dependency version check failed: ' + str(error), flush=True)
        return True


def version(value):
    match = re.fullmatch(r'v?(\d+)\.(\d+)\.(\d+)', value)
    if not match:
        raise ValueError('Expected a stable version')
    return tuple(map(int, match.groups()))


def read_state():
    try:
        value = json.loads(STATE.read_text())
        return value if isinstance(value, dict) else {}
    except (OSError, ValueError):
        return {}


def check():
    state = read_state()
    state['attempted_at'] = datetime.now(timezone.utc).isoformat()
    try:
        request = urllib.request.Request(API, headers={
            'Accept': 'application/vnd.github+json',
            'User-Agent': 'authelia-update-check',
        })
        with urllib.request.urlopen(request, timeout=15) as response:
            release = json.load(response)
        tag = release['tag_name']
        version(tag)
        if release.get('draft') or release.get('prerelease'):
            raise ValueError('Expected a published stable release')
        state.update(latest=tag, checked_at=state['attempted_at'], failed=False)
    except Exception as error:
        state['failed'] = True
        print('Authelia release check failed: ' + str(error), flush=True)
    dependencies_failed = check_dependencies(state)
    STATE.parent.mkdir(parents=True, exist_ok=True)
    temporary = STATE.with_suffix('.tmp')
    temporary.write_text(json.dumps(state) + '\n')
    temporary.chmod(0o644)
    os.replace(temporary, STATE)
    return 1 if state['failed'] or dependencies_failed else 0


def authelia_status(state):
    if state.get('failed'):
        print('Authelia: latest weekly check failed; see journalctl -u authelia-update-check.')
    try:
        checked = datetime.fromisoformat(state['checked_at'])
        latest = version(state['latest'])
        if datetime.now(timezone.utc) - checked > timedelta(days=8):
            print('Authelia: release information is more than 8 days old.')
        result = subprocess.run(['/usr/local/bin/authelia', '--version'],
                                capture_output=True, text=True, check=True, timeout=2)
        installed = re.search(r'\bv\d+\.\d+\.\d+\b', result.stdout).group()
        current = version(installed)
    except (KeyError, ValueError, AttributeError, OSError, subprocess.SubprocessError):
        print('Authelia: version status unavailable; see journalctl -u authelia-update-check.')
        return
    date = checked.strftime('%Y-%m-%d')
    if latest > current:
        print(f'Authelia: UPDATE AVAILABLE {installed} -> {state["latest"]} (checked {date}).')
        print(RELEASES + '/tag/' + state['latest'])
    else:
        print(f'Authelia: {installed}; latest known stable {state["latest"]} (checked {date}).')


def dependency_status(state):
    data = state.get('dependencies', {})
    if data.get('failed'):
        print('Dependencies: latest weekly check failed; see journalctl -u authelia-update-check.')
    try:
        checked = datetime.fromisoformat(data['checked_at'])
        if datetime.now(timezone.utc) - checked > timedelta(days=8):
            print('Dependencies: version information is more than 8 days old.')
        installed = inventory()
        cached = {key: {'name': item['name'], 'current': item['current']}
                  for key, item in data['items'].items()}
        if installed != cached:
            print('Dependencies: deployed files changed since the last check; refresh with systemctl start authelia-update-check.')
            return
        updates = []
        for location, item in data['items'].items():
            if version(item['latest']) > version(item['current']):
                major = ' [MAJOR]' if version(item['latest'])[0] > version(item['current'])[0] else ''
                updates.append(f'  {item["name"]}: {item["current"]} -> {item["latest"]}{major} ({location})')
    except (KeyError, TypeError, ValueError, OSError):
        print('Dependencies: version status unavailable; see journalctl -u authelia-update-check.')
        return
    print(f'Dependencies: {len(updates)} update(s) available / {len(installed)} checked (npm production + browser libraries; {checked:%Y-%m-%d}).')
    for line in sorted(updates):
        print(line)


def status():
    state = read_state()
    authelia_status(state)
    dependency_status(state)


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    modes = parser.add_mutually_exclusive_group(required=True)
    modes.add_argument('--check', action='store_true')
    modes.add_argument('--status', action='store_true')
    args = parser.parse_args()
    if args.check:
        raise SystemExit(check())
    status()
