{
  "name": "workoutbuddy",
  "version": "1.0.0",
  "description": "Web app de musculation locale",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "load:exercises": "node scripts/load-exercises.js",
    "test": "node --import ./tests/helpers/register-in-process.js --test tests/unit/*.test.js tests/integration/*.test.js tests/journeys/*.test.js",
    "test:affected": "node scripts/test-affected.js",
    "test:in-process": "node --import ./tests/helpers/register-in-process.js --test tests/unit/*.test.js tests/integration/*.test.js tests/journeys/*.test.js",
    "test:journeys": "node --test tests/journeys/*.test.js",
    "test:e2e": "node scripts/test-e2e.js",
    "test:e2e:affected": "node scripts/test-e2e-affected.js",
    "hooks:install": "node scripts/install-hooks.js",
    "test:e2e:report": "node scripts/test-e2e.js show-report test-results/report",
    "test:e2e:trace": "node scripts/test-e2e.js show-trace"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "express": "4.22.3"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  },
  "devDependencies": {
    "supertest": "7.3.1"
  },
  "engines": {
    "node": ">=24"
  }
}
