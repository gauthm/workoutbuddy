{
  "name": "workoutbuddy",
  "version": "1.0.0",
  "description": "Web app de musculation locale",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "load:exercises": "node scripts/load-exercises.js",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js tests/journeys/*.test.js",
    "test:in-process": "node --import ./tests/helpers/register-in-process.js --test tests/unit/*.test.js tests/integration/*.test.js tests/journeys/*.test.js",
    "test:journeys": "node --test tests/journeys/*.test.js"
  },
  "dependencies": {
    "express": "4.18.3",
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "supertest": "7.0.0"
  }
}
